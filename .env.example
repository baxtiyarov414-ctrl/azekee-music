# Copy this file to .env and fill in both values.
PORT=3000
NODE_ENV=development
# Generate a bcrypt hash with: npm run make-admin-hash
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# Use a long random secret (at least 32 characters)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
